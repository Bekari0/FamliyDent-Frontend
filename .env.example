MONGODB_URI=
CLIENT_URL=http://localhost:3000
VITE_SITE_URL=https://familydent.tj
VITE_GA_ID=
VITE_YANDEX_METRIKA_ID=
EMAIL_LOGO_URL=
EMAIL_HERO_IMAGE_URL=

# Синхронизация внешних отзывов
# Google Places API возвращает официально доступные отзывы через Place Details
# и отправляет их в админ-панель на модерацию.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=FamilyDent Душанбе

# Отзывы Яндекса импортируются из согласованного JSON-файла или JSON URL.
YANDEX_REVIEWS_JSON=
YANDEX_MAPS_REVIEWS_URL=https://yandex.ru/maps/org/femili_dent/16415187433/reviews/

# Через запятую: google,yandex
MAP_REVIEW_SOURCES=google,yandex

# Синхронизация отзывов через внешний парсер: apify или outscraper
REVIEWS_PROVIDER=
REVIEWS_API_KEY=
GOOGLE_MAPS_PLACE_URL=
YANDEX_MAPS_PLACE_URL=
REVIEWS_SYNC_LIMIT=100

# Дополнительные настройки для своих Apify actors
APIFY_GOOGLE_REVIEWS_ACTOR=compass/google-maps-reviews-scraper
APIFY_YANDEX_REVIEWS_ACTOR=zen-studio/yandex-maps-reviews-scraper

# Дополнительная автоматическая проверка отзывов через OpenRouter
OPENROUTER_API_KEY=
REVIEW_AI_MODERATION_ENABLED=false
REVIEW_AI_MODERATION_MODEL=
