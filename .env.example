MONGODB_URI=

# External reviews sync
# Google Places API returns the official reviews available through Place Details
# and sends them to admin moderation as pending reviews.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=FamilyDent Душанбе

# Yandex reviews are imported from an owner-approved JSON export or JSON URL.
YANDEX_REVIEWS_JSON=
YANDEX_MAPS_REVIEWS_URL=https://yandex.ru/maps/org/femili_dent/16415187433/reviews/

# Comma-separated: google,yandex
MAP_REVIEW_SOURCES=google,yandex
