# Copy to backend/.env. Never commit credentials. Environment variables take precedence.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=familydent_web
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate: openssl rand -hex 48
SESSION_SECRET=change-this-to-a-unique-random-secret-at-least-32-characters
SESSION_DAYS=7
LOG_LEVEL=info
# Exact trusted reverse proxy address/CIDR only; leave empty without a proxy.
TRUST_PROXY=
SERVE_FRONTEND=false
FRONTEND_DIST=../dist
WORKER_ENABLED=true

# Existing bot HTTP bridge. Disabled until both parties implement docs/BOT_CONTRACT.md.
BOT_ENABLED=false
BOT_API_URL=
BOT_API_TOKEN=
BOT_SIGNING_SECRET=
BOT_WEBHOOK_SECRET=
BOT_TIMEOUT_MS=10000
BOT_MAX_ATTEMPTS=8

# disabled | openai-compatible | ollama
AI_PROVIDER=disabled
# OpenAI-compatible: https://your-server.example/v1; Ollama: http://127.0.0.1:11434
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=512
AI_DAILY_REQUEST_LIMIT=30
# Only enable for trusted local/private HTTP endpoints. HTTPS is the default requirement.
INTEGRATIONS_ALLOW_HTTP=false

# Provisioning only: put this in backend/.env.migration.local, not the runtime environment.
# MONGODB_MIGRATION_URI=
# MONGODB_LEGACY_DATABASE=FamilyDent
