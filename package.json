{
  "name": "family-dent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:stack --workspace @familydent/backend",
    "dev:api": "npm run dev --workspace @familydent/backend",
    "dev:all": "npm run dev",
    "build": "npm run lint && npm run build:web && npm run build --workspace @familydent/backend",
    "start": "npm run start --workspace @familydent/backend",
    "media:set-url": "npm run media:set-url --workspace @familydent/backend",
    "preview": "vite preview",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "lint": "tsc --noEmit && npm run lint --workspace @familydent/backend",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx' && npm test --workspace @familydent/backend",
    "db:setup": "npm run db:setup --workspace @familydent/backend",
    "db:migrate": "npm run db:migrate --workspace @familydent/backend",
    "db:verify": "npm run db:verify --workspace @familydent/backend",
    "db:smoke": "npm run db:smoke --workspace @familydent/backend",
    "content:seed": "npm run content:seed --workspace @familydent/backend",
    "dev:web": "vite --host=0.0.0.0 --strictPort",
    "build:web": "vite build",
    "test:integration": "npm run test:integration --workspace @familydent/backend",
    "check": "npm run lint && npm test && npm run test:integration && npm run build && npm run lint:browser && npm run test:browser",
    "admin:create": "npm run admin:create --workspace @familydent/backend",
    "test:browser": "playwright test",
    "lint:browser": "tsc --noEmit -p tests/browser/tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "workspaces": [
    "backend"
  ]
}
